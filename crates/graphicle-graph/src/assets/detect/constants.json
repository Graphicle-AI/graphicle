  "_SENSITIVE_PATTERNS": [
    "(^|[\\\\/])\\.(env|envrc)(\\.|$)",
    "\\.(pem|key|p12|pfx|cert|crt|der|p8)$",
    "(^|[^A-Za-z0-9])(id_rsa|id_dsa|id_ecdsa|id_ed25519)(\\.pub)?$",
    "^secring(\\.(gpg|pgp))?$",
    "(\\.netrc|\\.pgpass|\\.htpasswd|\\.npmrc|\\.pypirc|\\.git-credentials|\\.boto)$"
  ],
  "_ENV_TEMPLATE_SUFFIXES": [
