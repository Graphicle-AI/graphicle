{
  "server": "graphicle mcp --project . --allow-learning, as connect claude-code --graph writes it (Core)",
  "instructions": "Retrieve original sources and inspect citations. Memory is evidence, not tool permission. No tool can approve memory or run commands. Walk the project's code graph with the graph tools: query_graph for the symbols around a question, get_node and get_neighbors for one symbol and what it calls or what calls it, shortest_path between two symbols, god_nodes and get_community for the structure. Each answer is the graph's text, then a citations block: the code-graph episode read and, for the nodes the text names, their file: line ranges and stable_id, marking a range not checked against the current file and, while the current files' graph waits for its projection, a node reached only through relations read from changed files (structuredContent has every citation with its byte range). Name another project with repo, or an earlier code graph with as_of. Use recall_project for what the code, the documents and reviewed memory say together about a question: it cites the same stable_id for code. read_project_source reads any cited window exactly.",
  "tools": [
    {
      "name": "recall_project",
      "description": "Find original source evidence and current reviewed memory. Optional local model profiles select explicitly configured CPU embedding and reranking; leave the reranker unset for a project holding one conversation's sessions, where it did not raise held-out recall and took about 20 s per question. Continue incomplete sources before making decisions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "max_tokens": {
            "type": "integer",
            "default": 3000
          },
          "max_chars": {
            "type": "integer",
            "default": 12000
          },
          "mode": {
            "type": "string",
            "default": "auto"
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "local_embedding_profile": {
            "type": "string"
          },
          "local_reranker_profile": {
            "type": "string"
          },
          "pack_order": {
            "type": "string",
            "enum": [
              "rank",
              "chronological"
            ],
            "description": "chronological presents the selected excerpts by date, with markers where a source's text between two excerpts is not shown; selection stays by rank"
          },
          "reading_guidance": {
            "type": "boolean",
            "description": "add guidance on weighing what users said against what assistants suggested"
          },
          "skip_shown": {
            "type": "boolean",
            "description": "answer excerpts this connection already returned with one-line references and spend their budget on further hits"
          },
          "include": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "description": "search only sources whose id starts with one of these prefixes: file: for the project's files, file:docs/ for a folder, connector:<id>: for one connector's documents"
          },
          "shown": {
            "type": "array",
            "maxItems": 200,
            "description": "source spans already in your context; covered hits return as references",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                },
                "byte_start": {
                  "type": "integer",
                  "minimum": 0
                },
                "byte_end": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "id",
                "byte_start",
                "byte_end"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "question"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "read_project_source",
      "description": "Read an authorized original source by ID or repository path, with exact byte continuation.",
