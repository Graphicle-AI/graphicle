    {
      "name": "propose_memory",
      "description": "Propose a decision, preference, procedure, task state or note as a draft memory. Every evidence quote must appear verbatim in a current source (for example a captured turn or a file). A quote that lies inside one code symbol anchors the memory to that symbol: an edit elsewhere in the file leaves the memory current, an edit inside the symbol withholds it. symbols names code symbols the memory is about; files are whole-file dependencies (any change to them withholds the memory). A member reviews the draft; it is never served as reviewed memory before that. Reusing the idempotency key with the same proposal replays it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "decision",
              "preference",
              "procedure",
              "task_state",
              "note"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 500
          },
          "body": {
            "type": "string",
            "maxLength": 64000
          },
          "reason": {
            "type": "string",
            "maxLength": 2000
          },
          "files": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string"
            },
            "description": "project files the memory depends on as a whole"
          },
          "symbols": {
            "type": "array",
            "maxItems": 50,
            "description": "code symbols the memory is about: a stable_id from the code graph, or a path and qualified_name (with kind or ordinal when several symbols share them)",
            "items": {
              "type": "object",
              "properties": {
                "stable_id": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "qualified_name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "ordinal": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string"
                },
                "quote": {
                  "type": "string",
                  "minLength": 8
                }
              },
              "required": [
