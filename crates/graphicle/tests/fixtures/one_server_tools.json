    {
      "name": "graph_as_of",
      "description": "Query either valid_at/known_at/branch for independent world and recording time, or the repository's typed code graph at an episode selector (`as_of`: episode id, commit sha label, `latest` or `working`), reconstructed from recorded history without re-extraction. Narrow with `node` (exact id), `query` (id substring) or `relations`; includes parent episode, labels and cardinality-one contradictions recorded at that episode.",
      "inputSchema": {
        "type": "object",
        "properties": {
