{
  "default_model": "spark",
  "models": {
    "spark": {
      "protocol": "responses",
      "base_url": "https://api.meta.ai/v1",
      "model": "muse-spark-1.3",
      "key_env": "MODEL_API_KEY",
      "input_limit": 1016576,
      "output_limit": 32000,
      "reasoning_effort": "medium",
      "price": {"input": 1.25, "output": 4.25, "cached_input": 0.15},
      "max_cost_per_call": 1.5,
      "max_cost_per_day": 10
    },
    "sam": {
      "protocol": "responses",
      "base_url": "https://api.meta.ai/v1",
      "model": "sam-3.1",
      "key_env": "MODEL_API_KEY",
      "price": {"input": 0, "output": 0, "per_image": 0.0025},
      "max_cost_per_day": 2
    }
  }
}
